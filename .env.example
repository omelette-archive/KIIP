# plus.kipris.or.kr 가입 후 "상표" 서비스 활용신청하고 발급받은 키를 넣는다.
# .env 로 복사해서 사용 (.env 는 git에 커밋하지 않는다).
KIPRIS_API_KEY=

# 공공데이터포털(data.go.kr) 일반 서비스키. 현재 실행 코드에서는 사용하지 않지만
# 이후 표준 REST API 소스를 추가할 때 재사용한다. LINK API(GI/농사로)에는 이 키를 쓰지 않는다.
DATA_GO_KR_API_KEY=

# 농림축산식품 공공데이터포털에서 활용신청·허용 IP 등록 후 발급받은 회원 API 키.
# 01-collect-specialties/lib/giClient.js — 국립농산물품질관리원 지리적표시 등록정보.
# https://data.mafra.go.kr/opendata/data/indexOpenDataDetail.do?data_id=20141224000000000399&service_ty=O
GI_API_KEY=
# 기본값: http://211.237.50.150:7080/openapi
# 공식 제공 주소가 바뀌거나 테스트 서버를 사용할 때만 재정의한다.
GI_API_BASE_URL=

# 농사로에서 활용신청 후 발급받은 Open API 인증키(apiKey).
# 01-collect-specialties/lib/nongsaroClient.js — 농촌진흥청 지역특산물("농사로") XML API.
# https://www.data.go.kr/data/15101361/openapi.do
NONGSARO_API_KEY=
# 같은 농사로 회원키로 별도 신청한 "지역 브랜드" 서비스 용도 메모.
# 03-match-trademarks/fetchAreaBrands.js가 areaBrandLst 검증자료를 소량 수집할 때 사용한다.
NONGSARO_LOCAL_BRAND_API_KEY=
# 기본값: https://api.nongsaro.go.kr/service/areaBrand
# 테스트 서버 또는 공식 URL 변경 시에만 재정의한다.
NONGSARO_AREA_BRAND_API_BASE_URL=
# 기본값: https://api.nongsaro.go.kr/service/localSpcprd
# 테스트 서버 또는 공식 URL 변경 시에만 재정의한다.
NONGSARO_API_BASE_URL=
